# Copier ce fichier en .env.local et remplir les valeurs VOUS-MÊME.
# Ne jamais publier .env.local (il est exclu de GitHub).

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://eeqeozctewmpmynmbwuw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# API Claude (console.anthropic.com > API Keys ; la clé commence par sk-ant-api)
ANTHROPIC_API_KEY=
# Seulement si la clé n'est rattachée à aucun workspace (sinon laisser vide)
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-4-5

# Google Cloud : Places API (New) + PageSpeed Insights API
GOOGLE_MAPS_API_KEY=

# E-mail OVH (boîte d'envoi de la prospection)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
IMAP_HOST=ssl0.ovh.net
IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Michael ZEBA - ZEMA TECHNOLOGIES

# Envoi : limite quotidienne de nouveaux contacts
DAILY_NEW_CONTACTS=10

# Adresse publique de l'application (pour les liens d'aperçu)
APP_URL=http://localhost:3000

# Accès à l'application : votre mot de passe et un jeton de session (longue chaîne aléatoire)
APP_PASSWORD=
APP_SESSION_TOKEN=
# Protège les tâches automatiques (envoi, lecture des réponses)
CRON_SECRET=
# Adresse qui reçoit les alertes lead chaud
ALERT_EMAIL=direction@zematechnologies.com
